# Gradle and Android build output
.gradle/
**/build/
local.properties
.externalNativeBuild/
.cxx/

# Kotlin build session directories
**/.kotlin/

# IDE and operating-system files
.idea/
*.iml
.DS_Store
Thumbs.db

# Android signing and secret material
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
.env
.env.*
secrets/

# Deterministic journey test-only TLS assets (documented exceptions; see
# fixtures/hermes/journey-tls/README.md). They never protect production traffic.
!fixtures/hermes/journey-tls/*.p12
!fixtures/hermes/journey-tls/*.pem

# Private planning and local evidence
.scratch/
coverage/
reports/
*.log
__pycache__/

# Deterministic journey local runs (downloaded and extracted by the runner)
maestro-cli/
maestro.zip
maestro-driver/

# Journey evidence collected by local and CI runs
artifacts/
